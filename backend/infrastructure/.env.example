# ─────────────────────────────────────────────────────────────────────────────
# TNT Supermarket — Environment Variable Template
# Copy this file to .env and fill in real values.
# NEVER commit .env to version control.
# ─────────────────────────────────────────────────────────────────────────────

# PostgreSQL credentials shared across all database containers
POSTGRES_USER=tnt_user
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# JWT Secret — must be at least 32 characters, cryptographically random
# Generate with: openssl rand -base64 32
JWT_SECRET_KEY=CHANGE_ME_GENERATE_WITH_OPENSSL_RAND_BASE64_32

# Identity Service database connection string
# Overrides appsettings.json ConnectionStrings:IdentityDb at runtime
# Set this to your real Supabase / PostgreSQL connection string
# Format: Host=<host>;Port=5432;Database=<db>;Username=<user>;Password=<pass>;SSL Mode=Require
ConnectionStrings__IdentityDb=

# Frontend origin allowed by CORS (no trailing slash)
CORS_ALLOWED_ORIGIN=http://localhost:5173

# API Gateway host port (use 5090 on macOS if AirPlay Receiver occupies 5000)
API_GATEWAY_PORT=5000

# Kafka bootstrap servers (override for production)
KAFKA_BOOTSTRAP_SERVERS=localhost:9094

# Optional: connection string for infrastructure/seed_and_test.js
# SUPABASE_DATABASE_URL=postgresql://<user>:<password>@aws-0-ap-south-1.pooler.supabase.com:5432/postgres
