# ─── Stage 1: Build ──────────────────────────────────────────────────────────
FROM mcr.microsoft.com/dotnet/sdk:10.0 AS build
WORKDIR /app

COPY backend/src/Gateway/TNT.ApiGateway/TNT.ApiGateway.csproj \
     ./backend/src/Gateway/TNT.ApiGateway/

RUN dotnet restore ./backend/src/Gateway/TNT.ApiGateway/TNT.ApiGateway.csproj

COPY backend/src/Gateway/ ./backend/src/Gateway/

WORKDIR /app/backend/src/Gateway/TNT.ApiGateway
RUN dotnet publish -c Release -o /out --no-restore

# ─── Stage 2: Runtime ────────────────────────────────────────────────────────
FROM mcr.microsoft.com/dotnet/aspnet:10.0 AS runtime
WORKDIR /app

RUN addgroup --system tnt && adduser --system --ingroup tnt tnt
USER tnt

COPY --from=build /out .

ENV ASPNETCORE_URLS=http://+:8080
EXPOSE 8080

ENTRYPOINT ["dotnet", "TNT.ApiGateway.dll"]
