# ─── Stage 1: Build ──────────────────────────────────────────────────────────
FROM mcr.microsoft.com/dotnet/sdk:10.0 AS build
WORKDIR /app

# Copy solution and all csprojs first for optimal layer caching
COPY backend/TNT.Supermarket.sln ./backend/
COPY backend/src/Services/Identity/TNT.IdentityService.Api/TNT.IdentityService.Api.csproj \
     ./backend/src/Services/Identity/TNT.IdentityService.Api/

RUN dotnet restore ./backend/src/Services/Identity/TNT.IdentityService.Api/TNT.IdentityService.Api.csproj

# Copy only the Identity Service source
COPY backend/src/Services/Identity/ ./backend/src/Services/Identity/

WORKDIR /app/backend/src/Services/Identity/TNT.IdentityService.Api
RUN dotnet publish -c Release -o /out --no-restore

# ─── Stage 2: Runtime ────────────────────────────────────────────────────────
FROM mcr.microsoft.com/dotnet/aspnet:10.0 AS runtime
WORKDIR /app

# Create a non-root user for security
RUN addgroup --system tnt && adduser --system --ingroup tnt tnt
USER tnt

COPY --from=build /out .

ENV ASPNETCORE_URLS=http://+:8080
EXPOSE 8080

ENTRYPOINT ["dotnet", "TNT.IdentityService.Api.dll"]
