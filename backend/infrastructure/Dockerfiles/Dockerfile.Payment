# ─── Stage 1: Build ──────────────────────────────────────────────────────────
FROM mcr.microsoft.com/dotnet/sdk:8.0 AS build
WORKDIR /app

COPY backend/src/Services/Payment/TNT.PaymentService.Api/TNT.PaymentService.Api.csproj \
     ./backend/src/Services/Payment/TNT.PaymentService.Api/

RUN dotnet restore ./backend/src/Services/Payment/TNT.PaymentService.Api/TNT.PaymentService.Api.csproj

COPY backend/src/Services/Payment/ ./backend/src/Services/Payment/

WORKDIR /app/backend/src/Services/Payment/TNT.PaymentService.Api
RUN dotnet publish -c Release -o /out --no-restore

# ─── Stage 2: Runtime ────────────────────────────────────────────────────────
FROM mcr.microsoft.com/dotnet/aspnet:8.0 AS runtime
WORKDIR /app

RUN addgroup --system tnt && adduser --system --ingroup tnt tnt
USER tnt

COPY --from=build /out .

ENV ASPNETCORE_URLS=http://+:8080
EXPOSE 8080

ENTRYPOINT ["dotnet", "TNT.PaymentService.Api.dll"]
