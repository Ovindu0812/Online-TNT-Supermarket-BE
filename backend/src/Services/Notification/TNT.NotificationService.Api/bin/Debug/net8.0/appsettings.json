{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning"
      }
    }
  },
  "Kafka": {
    "Enabled": false,
    "BootstrapServers": "localhost:9092",
    "UserEventsTopic": "user-events",
    "ConsumerGroup": "notification-service-group"
  },
  "Jwt": {
    "Issuer": "TNT.IdentityService",
    "Audience": "TNT.Supermarket"
  },
  "AllowedHosts": "*"
}
